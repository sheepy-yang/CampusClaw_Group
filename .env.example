# === 服务端密钥（勿提交真实值；复制为 .env 后按需修改）===
SESSION_SECRET=dev-session-secret
MYSQL_DSN=campusclaw:campusclaw@tcp(mysql:3306)/campusclaw?parseTime=true&charset=utf8mb4
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=campusclaw
MCP_TOKEN=dev-mcp-token
MCP_BASE_URL=http://mcp:8100

# 可选：配置后走真实模型；留空则使用离线演示合成
LLM_API_KEY=
LLM_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# === 对外端口 ===
