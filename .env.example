# 只列键名与演示默认值；复制为 .env 后按需修改。真实密钥不得提交。

# 运行环境与端口
APP_ENV=local
APP_PORT=8080
HTTP_PORT=8080
MCP_PORT=8100
WEB_PORT=80
SHUTDOWN_TIMEOUT=10s
HEALTH_TIMEOUT=2s

# 服务端安全配置
SESSION_SECRET=dev-session-secret
MCP_TOKEN=dev-mcp-token

# MySQL
MYSQL_ADDR=mysql:3306
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=campusclaw
MYSQL_USER=campusclaw
MYSQL_PASSWORD=campusclaw
MYSQL_DSN=campusclaw:campusclaw@tcp(mysql:3306)/campusclaw?parseTime=true&charset=utf8mb4

# Redis
REDIS_ADDR=redis:6379
REDIS_URL=redis://redis:6379/0

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=campusclaw

# MinIO
MINIO_URL=http://minio:9000
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=campusclaw

# MCP Host
MCP_URL=http://mcp:8100
MCP_BASE_URL=http://mcp:8100

# 模型网关（可留空：本地走离线演示合成）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=
