FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/worker ./cmd/worker

FROM alpine:3.20
RUN addgroup -S campusclaw \
    && adduser -S -G campusclaw campusclaw
WORKDIR /app
COPY --from=build /out/worker /app/worker
USER campusclaw
CMD ["/app/worker"]
